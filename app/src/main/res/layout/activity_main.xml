<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <FrameLayout
        android:id="@+id/browserRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 网页区域：铺满，搜索栏和底栏浮在上面（玻璃） -->
        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/chrome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:visibility="gone" />

        <!-- 搜索栏：紧挨底栏上方 -->
        <LinearLayout
            android:id="@+id/searchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="0dp">

            <com.example.gesturebrowser.GlassLayout
                android:id="@+id/searchPill"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:tag="25"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:id="@+id/btnEngine"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:alpha="0.45"
                        android:src="@drawable/ic_expand" />

                    <ImageView
                        android:id="@+id/engineIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_engine_bing" />
                </LinearLayout>

                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="搜索或输入网址"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/text_main"
                    android:textColorHint="#8F8A83"
                    android:textSize="17sp" />

                <ImageView
                    android:id="@+id/btnRefreshBar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.75"
                    android:padding="9dp"
                    android:src="@drawable/ic_refresh" />
            </com.example.gesturebrowser.GlassLayout>
        </LinearLayout>

        <!-- 底栏：后退 / 前进 / 菜单 / 标签页 / 主页（仿 UC） -->
        <com.example.gesturebrowser.GlassLayout
            android:id="@+id/bottomBar"
            android:tag="28"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="15dp"
                android:src="@drawable/ic_back" />

            <ImageView
                android:id="@+id/btnForward"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="15dp"
                android:src="@drawable/ic_forward" />

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="14dp"
                android:src="@drawable/ic_menu_lines" />

            <FrameLayout
                android:id="@+id/btnTabsWrap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/btnTabs"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_count"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="14dp"
                android:src="@drawable/ic_home_outline" />
        </com.example.gesturebrowser.GlassLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 网页视频全屏容器 -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
